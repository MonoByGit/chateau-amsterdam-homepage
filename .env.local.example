# ==============================================================================
# CHATEAU AMSTERDAM — ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# 1. Database (PostgreSQL 14+)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# 2. Application & Security
PUBLIC_SITE_URL=https://chateau.amsterdam
SESSION_SECRET=change-this-to-a-secure-random-32-character-secret
RESERVATION_ACTION_SECRET=change-this-to-a-secure-random-32-character-secret
ADMIN_PASSWORD_HASH=

# 3. Transactional Emails (Resend API)
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL="Chateau Amsterdam <reserveringen@updates.chateau.amsterdam>"
SALES_EMAIL=sales@chateau.amsterdam

# 4. Media Storage (S3 / Cloudflare R2 / AWS)
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto

# 5. Shopify Storefront API (Optioneel voor live winkelmand)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-10

# 6. Analytics (Umami - Optioneel)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
